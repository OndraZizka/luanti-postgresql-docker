<project>
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>my-luanti-server</artifactId>
    <version>1.0.0</version>

    <dependencies>
        <dependency><groupId>ch.zizka.luanti.mods.TenPlus1</groupId><artifactId>bakedclay</artifactId><version>31934</version><type>zip</type></dependency>
        <dependency><groupId>ch.zizka.luanti.mods.Jeija</groupId><artifactId>mesecons</artifactId><version>20230101</version><type>zip</type></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-mods</id><phase>prepare-package</phase><goals><goal>unpack-dependencies</goal></goals>
                        <configuration>
                            <includeTypes>zip</includeTypes>
                            <outputDirectory>${project.build.directory}/docker/mods</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>io.fabric8</groupId><artifactId>docker-maven-plugin</artifactId>
                <configuration>
                    <images>
                        <image>
                            <name>my-luanti-server</name>
                            <build>
                                <from>lscr.io/linuxserver/minetest:latest</from>
                                <assembly>
                                    <mode>dir</mode>
                                    <targetDir>/config/.minetest/mods</targetDir>
                                    <descriptorRef>artifact</descriptorRef>
                                </assembly>
                            </build>
                        </image>
                    </images>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>