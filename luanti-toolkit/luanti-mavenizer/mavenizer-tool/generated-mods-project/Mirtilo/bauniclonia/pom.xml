<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ch.zizka.luanti.Mirtilo</groupId>
    <artifactId>bauniclonia</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Bauniclonia</name>
    <description>Fresh and tasty textures, now in Mineclonia!</description>
    <url>https://content.luanti.org/packages/Mirtilo/bauniclonia/</url>

    <licenses>
        <license>
            <name>CC-BY-SA-4.0</name>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Mirtilo</id>
            <name>Mirtilo</name>
        </developer>
    </developers>

    <scm>
        <url>https://codeberg.org/mirtilo/Bauniclonia.git</url>
        <connection>scm:git:https://codeberg.org/mirtilo/Bauniclonia.git</connection>
    </scm>

    <properties>
        <revision>0.0.0-SNAPSHOT</revision>
        <luanti.release.url>http://localhost</luanti.release.url>
        <luanti.release.version>0.0.0</luanti.release.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <gpg.keyname>73BA361CA92D829800730DE207838E30786B5257</gpg.keyname>
        <!-- Set to true to auto-release from the Central Portal without manual review. -->
        <central.autoPublish>false</central.autoPublish>
    </properties>

    <profiles>
        <profile>
            <id>repackage-luanti</id>
            <build>
                <plugins>
                    <!-- Download the ContentDB release zip. -->
                    <plugin>
                        <groupId>com.googlecode.maven-download-plugin</groupId>
                        <artifactId>download-maven-plugin</artifactId>
                        <version>1.6.8</version>
                        <executions>
                            <execution>
                                <id>download-mod</id>
                                <phase>generate-resources</phase>
                                <goals><goal>wget</goal></goals>
                                <configuration>
                                    <url>${luanti.release.url}</url>
                                    <outputFileName>mod.zip</outputFileName>
                                    <outputDirectory>${project.build.directory}/download</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Attach the raw zip as the main (classifier-less) artifact of type "zip". -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.2</version>
                        <executions>
                            <execution>
                                <id>attach-mod-zip</id>
                                <phase>package</phase>
                                <goals><goal>attach-artifact</goal></goals>
                                <configuration>
                                    <artifacts>
                                        <artifact>
                                            <file>${project.build.directory}/download/mod.zip</file>
                                            <type>zip</type>
                                        </artifact>
                                    </artifacts>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Sign the pom and the zip with GPG, required by Maven Central. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Publish to Maven Central via the Central Portal Publisher API. -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>${central.autoPublish}</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>