<?xml version="1.0" encoding="UTF-8"?>
<!-- Equivalent of step30-luanti-mineclonia-DemoWorld/Dockerfile + build.sh -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.zizka.luanti</groupId>
        <artifactId>luanti-postgresql-docker</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>step30-luanti-mineclonia-demoworld</artifactId>
    <packaging>pom</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>io.fabric8</groupId>
                <artifactId>docker-maven-plugin</artifactId>
                <configuration>
                    <images>
                        <image>
                            <name>${docker.user}/luanti-mineclonia-demo:latest</name>
                            <build>
                                <from>${docker.user}/luanti-mineclonia-easy:latest</from>
                                <!-- Needs BuildKit: the legacy builder discards everything written under the base image's VOLUME /config/.minetest. -->
                                <buildx>
                                    <platforms>
                                        <platform>${docker.platform}</platform>
                                    </platforms>
                                </buildx>
                                <env>
                                    <!-- LSIO_LUANTI_BASE_DIR is inherited from the base image. -->
                                    <THIS_WORLD_DIR>$LSIO_LUANTI_BASE_DIR/worlds/DemoWorld</THIS_WORLD_DIR>
                                </env>
                                <!-- Ensure the build fails if any RUN command fails -->
                                <shell>
                                    <arg>/bin/bash</arg>
                                    <arg>-o</arg>
                                    <arg>pipefail</arg>
                                    <arg>-c</arg>
                                </shell>
                                <runCmds>
                                    <run><![CDATA[mkdir -p "$THIS_WORLD_DIR" && cp /templates/template_world.mt "$THIS_WORLD_DIR/world.mt"]]></run>
                                    <!-- Enable all mods for this world which is being prepared. -->
                                    <run>echo "" >> "$THIS_WORLD_DIR/world.mt"</run>
                                    <run>cat /enableAllMods-putTo-world.mt >> "$THIS_WORLD_DIR/world.mt"</run>
                                </runCmds>
                            </build>
                        </image>
                    </images>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
